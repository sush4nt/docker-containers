# Copy to .env and uncomment what you need. Every value is optional.

# Host folder with your projects, mounted at /workspace. Default: parent folder of this repo.
# Windows (use forward slashes) / macOS / Linux:
# WORKSPACE_DIR=C:/Users/<you>/projects
# WORKSPACE_DIR=/Users/<you>/projects
# WORKSPACE_DIR=/home/<you>/projects

# Linux only: match your host user so files in /workspace keep your ownership (`id -u`, `id -g`).
# USER_UID=1000
# USER_GID=1000

# Host ports (bound to localhost only)
# GENERAL_PORT=8888
# DEEP_PORT=8889
# SPARK_PORT=8890
# SPARK_UI_PORT=4040

# Jupyter token. Empty = no login, acceptable only because ports are localhost-bound.
# JUPYTER_TOKEN=

# Private package index (Artifactory, Nexus, ...). uv tries it before PyPI.
# UV_INDEX=https://<user>:<token>@artifactory.example.com/artifactory/api/pypi/pypi/simple
# Or replace PyPI entirely:
# UV_DEFAULT_INDEX=https://artifactory.example.com/artifactory/api/pypi/pypi/simple
