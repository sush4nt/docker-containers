#!/usr/bin/env bash
# Remove an env and its Jupyter kernel. Usage: rmenv <name>
set -euo pipefail

name="${1:?usage: rmenv <name>}"
[[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "invalid env name: $name" >&2; exit 1; }

rm -rf "/envs/$name" "/envs/.jupyter/kernels/$name"
echo "✓ removed env + kernel: $name"
